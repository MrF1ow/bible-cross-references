{
  "name": "bible-cross-references",
  "version": "0.1.0",
  "private": true,
  "description": "A minimalist, interactive explorer of Bible cross-references.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run data:build && bun --bun vite",
    "build": "bun run data:build && bun --bun tsc -b && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc -b",
    "typecoverage": "bun scripts/type-coverage.ts",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:built": "bun --bun vitest run scripts/data/built-datasets.test.ts",
    "test:e2e": "playwright test --project=desktop --project=phone --project=offline",
    "test:e2e:ci": "CI=1 playwright test --project=desktop --project=phone --project=offline",
    "test:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "test:visual:update": "bun run test:visual -- --update-snapshots",
    "test:report": "playwright show-report",
    "check": "bun run typecheck && bun run typecoverage && bun run lint && bun run format:check && bun run test:coverage",
    "data": "bun run data:fetch && bun run data:build",
    "data:fetch": "bun scripts/data/fetch.ts",
    "data:build": "bun scripts/data/build.ts",
    "locale:new": "bun scripts/locale/new.ts",
    "mcp": "bun mcp/server.ts",
    "mcp:http": "bun mcp/server.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
